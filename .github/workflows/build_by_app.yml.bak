name: Build Nexa By GitHub App

on:
  workflow_dispatch:
    inputs:
      version:
        description: "Release version, for example: v1.0.0"
        required: true
        default: "v1.0.0"

  repository_dispatch:
    types:
      - nexa-push

permissions:
  contents: read


jobs:

  # ==========================================================
  # Build Matrix
  # ==========================================================

  build:

    name: ${{ matrix.target }}

    strategy:
      fail-fast: false

      matrix:
        include:

          # --------------------------------------------------
          # Dart CLI
          # --------------------------------------------------

          - target: actions-linux
            os: ubuntu-latest

          - target: actions-windows
            os: windows-latest


          # --------------------------------------------------
          # Flutter Desktop
          # --------------------------------------------------

          - target: commander-linux
            os: ubuntu-latest

          - target: commander-windows
            os: windows-latest


          # --------------------------------------------------
          # Flutter Android
          # --------------------------------------------------

          - target: commander-android
            os: ubuntu-latest


    runs-on: ${{ matrix.os }}


    steps:

      # ======================================================
      # 1. Generate GitHub App installation token
      #
      # Nexa Build App
      # App ID: 4798967
      #
      # The token is temporary and scoped to:
      # u4-d/nexa
      # ======================================================

      - name: Generate GitHub App token
        id: app-token
        uses: actions/create-github-app-token@v3
        with:
          client-id: ${{ secrets.NEXA_APP_ID }}
          private-key: ${{ secrets.NEXA_APP_PRIVATE_KEY }}
          owner: u4-d
          repositories: nexa


      # ======================================================
      # 2. Checkout private nexa
      # ======================================================

      - name: Checkout private nexa
        uses: actions/checkout@v4
        with:
          repository: u4-d/nexa
          token: ${{ steps.app-token.outputs.token }}
          path: nexa
          fetch-depth: 1


      # ======================================================
      # 3. Setup Flutter
      #
      # Flutter 3.44.9
      # Dart 3.12.2
      #
      # Same as local development environment.
      # ======================================================

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: "3.44.9"
          channel: stable
          cache: true


      # ======================================================
      # 3.1 Enable Linux desktop
      # ======================================================

      - name: Enable Linux desktop
        if: matrix.target == 'commander-linux'
        run: |
          flutter config --enable-linux-desktop


      # ======================================================
      # 3.2 Install Linux desktop dependencies
      # ======================================================

      - name: Install Linux desktop dependencies
        if: matrix.target == 'commander-linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            clang \
            cmake \
            ninja-build \
            pkg-config \
            libgtk-3-dev


      # ======================================================
      # 3.3 Enable Windows desktop
      # ======================================================

      - name: Enable Windows desktop
        if: matrix.target == 'commander-windows'
        run: |
          flutter config --enable-windows-desktop


      # ======================================================
      # 4. Show Flutter and Dart versions
      # ======================================================

      - name: Show Flutter and Dart versions
        run: |
          flutter --version
          dart --version


      # ======================================================
      # 5. Setup Python
      #
      # Only required by Windows actions.
      # ======================================================

      - name: Setup Python
        if: matrix.target == 'actions-windows'
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"


      # ======================================================
      # 6. Cache pip
      # ======================================================

      - name: Cache pip
        if: matrix.target == 'actions-windows'
        uses: actions/cache@v4
        with:
          path: ~\AppData\Local\pip\Cache
          key: ${{ runner.os }}-pip-pyinstaller-v1


      # ======================================================
      # 7. Install Python dependencies
      # ======================================================

      - name: Install Python dependencies
        if: matrix.target == 'actions-windows'
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install pandas xlrd pyinstaller


      # ======================================================
      # 8. Check Linux desktop project
      # ======================================================

      - name: Check Linux desktop project
        if: matrix.target == 'commander-linux'
        working-directory: nexa/nexa_commander
        run: |
          echo "===== Flutter ====="
          flutter --version

          echo "===== Flutter config ====="
          flutter config

          echo "===== Project ====="
          ls -la

          echo "===== Linux ====="
          ls -la linux
          ls -la linux/flutter
          ls -la linux/runner

          echo "===== Git files ====="
          git ls-files linux/

          echo "===== Flutter devices ====="
          flutter devices


      # ======================================================
      # 9. Check Windows desktop project
      # ======================================================

      - name: Check Windows desktop project
        if: matrix.target == 'commander-windows'
        working-directory: nexa/nexa_commander
        shell: pwsh
        run: |
          Write-Host "===== Flutter ====="
          flutter --version

          Write-Host "===== Flutter config ====="
          flutter config

          Write-Host "===== Project ====="
          Get-ChildItem

          Write-Host "===== Windows ====="
          Get-ChildItem windows
          Get-ChildItem windows\flutter
          Get-ChildItem windows\runner

          Write-Host "===== Git files ====="
          git ls-files windows\

          Write-Host "===== Flutter devices ====="
          flutter devices


      # ======================================================
      # 10. Get dependencies
      #
      # nexa is a Dart/Flutter Workspace.
      #
      # No pubspec_overrides.yaml.
      # ======================================================

      - name: Get workspace dependencies
        working-directory: nexa
        run: |
          flutter pub get


      # ======================================================
      # 11. Build actions - Linux
      # ======================================================

      - name: Build actions Linux
        if: matrix.target == 'actions-linux'
        working-directory: nexa
        run: |
          dart compile exe \
            actions/bin/actions.dart \
            -o ../actions-linux


      # ======================================================
      # 12. Build actions - Windows
      # ======================================================

      - name: Build actions Windows
        if: matrix.target == 'actions-windows'
        working-directory: nexa
        shell: pwsh
        run: |
          dart compile exe `
            actions/bin/actions.dart `
            -o ..\actions-windows.exe


      # ======================================================
      # 13. Build convert_xls_to_csv.exe
      # ======================================================

      - name: Build convert_xls_to_csv.exe
        if: matrix.target == 'actions-windows'
        working-directory: nexa
        shell: pwsh
        run: |
          pyinstaller `
            --onefile `
            --name convert_xls_to_csv `
            convert_xls_to_csv.py

          Copy-Item `
            dist\convert_xls_to_csv.exe `
            ..\convert_xls_to_csv.exe


      # ======================================================
      # 14. Ensure Linux desktop project
      #
      # The source repository already contains linux/.
      #
      # flutter create makes sure the CI environment has
      # a valid Linux Flutter desktop project.
      # ======================================================

      - name: Ensure Linux desktop project
        if: matrix.target == 'commander-linux'
        working-directory: nexa/nexa_commander
        run: |
          flutter config --enable-linux-desktop
          flutter create . --platforms=linux


      # ======================================================
      # 15. Build nexa_commander - Linux
      # ======================================================

      - name: Build nexa_commander Linux
        if: matrix.target == 'commander-linux'
        working-directory: nexa/nexa_commander
        run: |
          flutter build linux --release


      # ======================================================
      # 16. Ensure Windows desktop project
      #
      # The source repository already contains windows/.
      #
      # flutter create makes sure the CI environment has
      # a valid Windows Flutter desktop project.
      # ======================================================

      - name: Ensure Windows desktop project
        if: matrix.target == 'commander-windows'
        working-directory: nexa/nexa_commander
        run: |
          flutter config --enable-windows-desktop
          flutter create . --platforms=windows


      # ======================================================
      # 17. Build nexa_commander - Windows
      # ======================================================

      - name: Build nexa_commander Windows
        if: matrix.target == 'commander-windows'
        working-directory: nexa/nexa_commander
        run: |
          flutter build windows --release


      # ======================================================
      # 18. Build nexa_commander - Android
      # ======================================================

      - name: Build nexa_commander Android
        if: matrix.target == 'commander-android'
        working-directory: nexa/nexa_commander
        run: |
          flutter build apk --release


      # ======================================================
      # 19. Prepare actions Linux artifact
      # ======================================================

      - name: Prepare actions Linux artifact
        if: matrix.target == 'actions-linux'
        run: |
          mkdir -p artifact/linux

          cp \
            actions-linux \
            artifact/linux/actions


      # ======================================================
      # 20. Prepare actions Windows artifact
      # ======================================================

      - name: Prepare actions Windows artifact
        if: matrix.target == 'actions-windows'
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force `
            artifact\windows

          Copy-Item `
            actions-windows.exe `
            artifact\windows\actions.exe

          Copy-Item `
            convert_xls_to_csv.exe `
            artifact\windows\convert_xls_to_csv.exe


      # ======================================================
      # 21. Prepare commander Linux artifact
      # ======================================================

      - name: Prepare commander Linux artifact
        if: matrix.target == 'commander-linux'
        run: |
          mkdir -p artifact/linux/nexa_commander

          cp -R \
            nexa/nexa_commander/build/linux/x64/release/bundle/* \
            artifact/linux/nexa_commander/


      # ======================================================
      # 22. Prepare commander Windows artifact
      # ======================================================

      - name: Prepare commander Windows artifact
        if: matrix.target == 'commander-windows'
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force `
            artifact\windows\nexa_commander

          Copy-Item `
            nexa\nexa_commander\build\windows\x64\runner\Release\* `
            artifact\windows\nexa_commander\ `
            -Recurse


      # ======================================================
      # 23. Prepare commander Android artifact
      # ======================================================

      - name: Prepare commander Android artifact
        if: matrix.target == 'commander-android'
        run: |
          mkdir -p artifact/android

          cp \
            nexa/nexa_commander/build/app/outputs/flutter-apk/app-release.apk \
            artifact/android/nexa-commander.apk


      # ======================================================
      # 24. Upload Matrix artifact
      # ======================================================

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.target }}
          path: artifact
          retention-days: 1


  # ==========================================================
  # Package Release
  # ==========================================================

  package:

    name: Package Release

    needs: build

    runs-on: ubuntu-latest

    permissions:
      contents: write


    steps:

      # ======================================================
      # 25. Download all build artifacts
      # ======================================================

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts


      # ======================================================
      # 26. Show artifacts
      # ======================================================

      - name: Show artifact structure
        run: |
          echo "===== Artifacts ====="
          find artifacts -print | sort


      # ======================================================
      # 27. Prepare release directories
      # ======================================================

      - name: Prepare release directories
        run: |
          mkdir -p release/nexa-actions
          mkdir -p release/nexa-commander


      # ======================================================
      # 28. Assemble nexa-actions
      # ======================================================

      - name: Assemble nexa-actions
        run: |

          mkdir -p release/nexa-actions/linux
          mkdir -p release/nexa-actions/windows

          cp \
            artifacts/actions-linux/linux/actions \
            release/nexa-actions/linux/actions

          cp \
            artifacts/actions-windows/windows/actions.exe \
            release/nexa-actions/windows/actions.exe

          cp \
            artifacts/actions-windows/windows/convert_xls_to_csv.exe \
            release/nexa-actions/windows/convert_xls_to_csv.exe


      # ======================================================
      # 29. Assemble nexa-commander
      # ======================================================

      - name: Assemble nexa-commander
        run: |

          mkdir -p release/nexa-commander/linux
          mkdir -p release/nexa-commander/windows
          mkdir -p release/nexa-commander/android

          cp -R \
            artifacts/commander-linux/linux/nexa_commander \
            release/nexa-commander/linux/

          cp -R \
            artifacts/commander-windows/windows/nexa_commander \
            release/nexa-commander/windows/

          cp \
            artifacts/commander-android/android/nexa-commander.apk \
            release/nexa-commander/android/nexa-commander.apk


      # ======================================================
      # 30. Show final release structure
      # ======================================================

      - name: Show final release structure
        run: |
          echo "===== Final Release ====="
          find release -print | sort


      # ======================================================
      # 31. Create nexa-actions.zip
      # ======================================================

      - name: Create encrypted nexa-actions.zip
        run: |
          sudo apt-get update && sudo apt-get install -y p7zip-full
          cd release
          7z a -tzip -p"${{ secrets.ARCHIVE_PASSWORD }}" ../nexa-actions.zip nexa-actions


      # ======================================================
      # 32. Create nexa-commander.zip
      # ======================================================

      - name: Create encrypted nexa-commander.zip
        run: |
          cd release
          7z a -tzip -p"${{ secrets.ARCHIVE_PASSWORD }}" ../nexa-commander.zip nexa-commander


      # ======================================================
      # 33. Create GitHub Release
      # ======================================================

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ inputs.version }}
          name: Nexa ${{ inputs.version }}
          generate_release_notes: true
          files: |
            nexa-actions.zip
            nexa-commander.zip
